{
  "version": "2.0.0",
  "tasks": [
	{
		"label": "Test: Web",
		"detail": "Run the TypeScript tests (requires Node.js 24 or newer).",
		"type": "shell",
		"command": "npm",
		"windows": {
			"command": "npm.cmd"
		},
		"args": [
			"test"
		],
		"options": {
			"cwd": "${workspaceFolder}/web"
		},
		"group": "test",
		"problemMatcher": []
	},
	{
		"label": "Test: Android",
		"type": "shell",
		"command": "./gradlew",
		"windows": {
			"command": ".\\gradlew.bat"
		},
		"args": [
			"testDebugUnitTest"
		],
		"options": {
			"cwd": "${workspaceFolder}/android"
		},
		"group": "test",
		"problemMatcher": []
	},
	{
		"label": "Test: All",
		"dependsOn": [
			"Test: Web",
			"Test: Android"
		],
		"dependsOrder": "sequence",
		"group": {
			"kind": "test",
			"isDefault": true
		},
		"problemMatcher": []
	},
	{
		"label": "Build: Debug APK",
		"type": "shell",
		"command": "./gradlew",
		"windows": {
			"command": ".\\gradlew.bat"
		},
		"args": [
			"assembleDebug"
		],
		"options": {
			"cwd": "${workspaceFolder}/android"
		},
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"problemMatcher": []
	}
]
}
