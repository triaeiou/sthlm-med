<?xml version="1.0" encoding="utf-8"?>
<!--
  gfx/sthlm-med.png as an adaptive icon: its white symbol (the PNG's brightness as alpha) on black, scaled to fit the
  66 dp safe zone so no launcher mask clips it. The same layer serves as the themed (monochrome) icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
